<link rel="stylesheet" href="sz-sidebar.css" webc:scoped="sz-sidebar" />

<header webc:root="override" data-sidebar>
  <div>
    <div class="identity">
      <p class="site-name">Sebastian Zelonka</p>
      <h2>UI Engineer <span aria-hidden="true">↗</span></h2>
    </div>
    <p class="intro">Pixel-perfect, performant, and accessible products on the web.</p>
  </div>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation-panel">
    <span class="menu-label">Menu</span>
    <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
  </button>

  <div class="navigation-panel" id="navigation-panel">
    <p class="panel-label">Navigation</p>
    <nav aria-label="Primary navigation">
      <a href="/"><span>01</span> Home</a>
      <a href="/about"><span>02</span> About</a>
      <a href="/experience"><span>03</span> Experience</a>
      <a href="/blog"><span>04</span> Some Thoughts</a>
      <a href="/til"><span>05</span> Field Notes</a>
    </nav>
    <div class="mobile-theme" data-theme-selector role="group" aria-label="Color theme">
      <p>Appearance</p>
      <div>
        <button type="button" data-theme="system" aria-pressed="true">Auto</button>
        <button type="button" data-theme="light" aria-pressed="false">Light</button>
        <button type="button" data-theme="dark" aria-pressed="false">Dark</button>
      </div>
    </div>
  </div>
  <button class="menu-backdrop" type="button" tabindex="-1" aria-label="Close navigation"></button>

  <script webc:keep>
    (() => {
      const header = document.querySelector("[data-sidebar]");
      const toggle = header?.querySelector(".menu-toggle");
      const nav = header?.querySelector("nav");
      const backdrop = header?.querySelector(".menu-backdrop");
      if (!header || !toggle || !nav || !backdrop) return;

      const currentPath = location.pathname.replace(/\/$/, "") || "/";
      const activePath = currentPath;
      nav.querySelectorAll("a").forEach((link) => {
        const linkPath = new URL(link.href, location.origin).pathname.replace(/\/$/, "") || "/";
        const isCurrent = linkPath === "/"
          ? activePath === "/"
          : activePath === linkPath || activePath.startsWith(`${linkPath}/`);
        if (isCurrent) link.setAttribute("aria-current", "page");
      });

      const close = () => {
        header.classList.remove("menu-open");
        document.body.classList.remove("menu-active");
        toggle.setAttribute("aria-expanded", "false");
      };

      toggle.addEventListener("click", () => {
        const open = !header.classList.contains("menu-open");
        header.classList.toggle("menu-open", open);
        document.body.classList.toggle("menu-active", open);
        toggle.setAttribute("aria-expanded", String(open));
        if (open) requestAnimationFrame(() => nav.querySelector("a")?.focus());
      });
      backdrop.addEventListener("click", () => {
        close();
        toggle.focus();
      });
      nav.addEventListener("click", (event) => {
        if (event.target.closest("a")) close();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && header.classList.contains("menu-open")) {
          close();
          toggle.focus();
        }
      });
    })();
  </script>
</header>
