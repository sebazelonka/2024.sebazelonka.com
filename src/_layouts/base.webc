<!DOCTYPE html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sebastian Zelonka's personal website" />
    <meta name="theme-color" content="#050505" />
    <title>Sebastian Zelonka</title>
    <script webc:keep>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        if (["light", "dark"].includes(savedTheme)) {
          document.documentElement.dataset.theme = savedTheme;
        }
      })();
    </script>
    <link
      rel="stylesheet"
      href="https://use.typekit.net/cne0gpf.css"
      webc:keep
      prefetch
    />
    <link rel="preconnect" href="https://rsms.me/" webc:keep />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" webc:keep />
    <link rel="stylesheet" href="/css/styles.css" webc:keep />
    <link rel="stylesheet" :href="getBundleFileUrl('css')" webc:keep />
    <!-- <style @raw="getCss(page.url)" webc:keep></style> -->
  </head>
  <body class="container">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <sz-sidebar> </sz-sidebar>
    <main id="main-content" @raw="content"></main>
    <sz-footer></sz-footer>
    <details class="theme-control">
      <summary aria-label="Choose color theme" title="Choose color theme">
        <span class="theme-icon" aria-hidden="true"></span>
      </summary>
      <div class="theme-menu" data-theme-selector role="group" aria-label="Color theme">
        <button type="button" data-theme="system" aria-pressed="true">Auto</button>
        <button type="button" data-theme="light" aria-pressed="false">Light</button>
        <button type="button" data-theme="dark" aria-pressed="false">Dark</button>
      </div>
    </details>
    <script webc:keep>
      (() => {
        const root = document.documentElement;
        const controls = [...document.querySelectorAll("[data-theme-selector]")];
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        if (!controls.length) return;

        const update = (theme, persist = true) => {
          root.dataset.theme = theme;
          controls.forEach((control) => {
            control.querySelectorAll("button").forEach((button) => {
              button.setAttribute("aria-pressed", String(button.dataset.theme === theme));
            });
          });

          const isDark = theme === "dark" || (theme === "system" && media.matches);
          themeColor?.setAttribute("content", isDark ? "#050505" : "#f7f4ec");

          if (persist) {
            if (theme === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", theme);
          }
        };

        controls.forEach((control) => control.addEventListener("click", (event) => {
            const button = event.target.closest("button[data-theme]");
            if (button) {
              update(button.dataset.theme);
              control.closest("details")?.removeAttribute("open");
            }
          })
        });

        media.addEventListener("change", () => {
          if (root.dataset.theme === "system") update("system", false);
        });

        update(root.dataset.theme, false);
      })();
    </script>
  </body>
</html>
